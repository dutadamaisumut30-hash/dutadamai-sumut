# Salin ke docker/produksi.env DI SERVER, lalu isi semua nilai. File itu tidak masuk git.
# Buat rahasia acak dengan: openssl rand -base64 32   (KONTAK_ENCRYPTION_KEY harus tepat 32 byte, base64)

DOMAIN=contoh.or.id

# Database. Kata sandi yang sama harus ada di DATABASE_URL.
POSTGRES_USER=dutadamai
POSTGRES_PASSWORD=
POSTGRES_DB=dutadamai
DATABASE_URL=postgres://dutadamai:ISI-KATA-SANDI-DI-SINI@db:5432/dutadamai

# Login.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://contoh.or.id

# Enkripsi kontak pengirim (ADR 005). Simpan salinannya di password manager bersama (ADR 004).
# Jika hilang, kontak yang sudah tersimpan tidak bisa dibaca lagi. Jangan pakai kunci dari laptop.
KONTAK_ENCRYPTION_KEY=

# Cloudflare Turnstile, kunci untuk domain asli. Kunci situs ditanam saat build.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Alamat situs untuk sitemap dan RSS.
NEXT_PUBLIC_SITE_URL=https://contoh.or.id

# Umami (opsional, tanpa cookie). Kosongkan jika belum ada. Ditanam saat build.
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_ID=
NEXT_PUBLIC_UMAMI_DASHBOARD=

# Produksi: Editor dan Admin wajib 2FA. JANGAN isi WAJIB_2FA=0, NEXT_PUBLIC_MODE_UJI, atau NEXT_PUBLIC_SANDI_UJI di sini.
