# Salin ke .env untuk pengembangan lokal. JANGAN commit .env.
# Produksi memakai docker/produksi.env.example.
DATABASE_URL=postgres://dutadamai:dutadamai@localhost:5432/dutadamai
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# 32 byte acak, base64. Buat dengan: openssl rand -base64 32
KONTAK_ENCRYPTION_KEY=
# Kunci uji Cloudflare Turnstile (selalu lolos). Ganti dengan kunci asli di produksi.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Folder berkas unggahan. Biarkan dikomentari agar memakai ./penyimpanan.
# PENYIMPANAN_DIR=

# Uji jarak jauh / staging (lihat docs/uji-jarak-jauh.md)
# BETTER_AUTH_URL=https://alamat-tunnel-kamu
# BETTER_AUTH_TRUSTED_ORIGINS=https://alamat-tunnel-kamu
# ALLOWED_ORIGINS=alamat-tunnel-kamu
# ALLOWED_DEV_ORIGINS=alamat-tunnel-kamu
# NEXT_PUBLIC_MODE_UJI=1      # tombol "Masuk sebagai ..." di /masuk. JANGAN aktifkan di produksi.
# NEXT_PUBLIC_SANDI_UJI=
# WAJIB_2FA=0                 # hanya staging; di produksi 2FA wajib untuk Editor dan Admin
# NEXT_PUBLIC_SITE_URL=https://domain-kamu
# NEXT_PUBLIC_UMAMI_URL=https://umami.domain-kamu
# NEXT_PUBLIC_UMAMI_ID=
# NEXT_PUBLIC_UMAMI_DASHBOARD=
